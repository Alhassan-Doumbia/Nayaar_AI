# Copier ce fichier en .env (jamais commité) et renseigner les valeurs réelles.

# --- Claude (API Anthropic) --------------------------------------------------
# Obligatoire pour /api/chat. Ne jamais mettre la clé en dur dans le code.
ANTHROPIC_API_KEY=sk-ant-votre-cle-ici

# --- Fichiers de données (Knowledge Base, vecteurs, vocabulaire) ------------
# Chemins relatifs à la racine du projet, ou absolus. Les valeurs ci-dessous
# sont déjà les valeurs par défaut utilisées si ces variables sont absentes
# (voir main.py, semantic_search.py, hybrid.py) — à ne changer que si vos
# fichiers de données vivent ailleurs.
NAYAAR_KNOWLEDGE_BASE_PATH=data/processed/nayaar_knowledge_base.csv
NAYAAR_VOCABULARY_PATH=data/processed/notes_vocabulary.json
NAYAAR_FAISS_INDEX_PATH=data/processed/nayaar_index.faiss
NAYAAR_FAISS_MAPPING_PATH=data/processed/nayaar_index_mapping.json

# --- CORS ---------------------------------------------------------------------
# Origines autorisées à appeler l'API, séparées par des virgules.
# http://localhost:3000 = frontend Next.js en développement local.
CORS_ORIGINS=http://localhost:3000
